     return E_NOTIMPL;
 }
+
+/* Riftway: whether decoded frames fit in the device's textures. A Direct3D 11
+ * device without NV12 textures (DXMT on Metal) cannot hold them, and the
+ * allocator would fail every sample. */
+static BOOL device_holds_frames(IUnknown *manager)
+{
+    static const GUID iid_dxgi_device_manager = {0xeb533d5d, 0x2db6, 0x40f8, {0x97, 0xa9, 0x49, 0x46, 0x92, 0x01, 0x4f, 0x07}};
+    static const GUID iid_d3d11_device = {0xdb6f6ddb, 0xac77, 0x4e88, {0x82, 0x53, 0x81, 0x9d, 0xf9, 0xbb, 0xf1, 0x40}};
+    IMFDXGIDeviceManager *dxgi;
+    ID3D11Device *device;
+    UINT support = 0;
+    HANDLE handle;
 
+    if (FAILED(IUnknown_QueryInterface(manager, &iid_dxgi_device_manager, (void **)&dxgi)))
+        return TRUE;
+    if (SUCCEEDED(IMFDXGIDeviceManager_OpenDeviceHandle(dxgi, &handle)))
+    {
+        if (SUCCEEDED(IMFDXGIDeviceManager_GetVideoService(dxgi, handle, &iid_d3d11_device, (void **)&device)))
+        {
+            if (FAILED(ID3D11Device_CheckFormatSupport(device, DXGI_FORMAT_NV12, &support)))
+                support = 0;
+            ID3D11Device_Release(device);
+        }
+        IMFDXGIDeviceManager_CloseDeviceHandle(dxgi, handle);
+    }
+    IMFDXGIDeviceManager_Release(dxgi);
+    return !!(support & D3D11_FORMAT_SUPPORT_TEXTURE2D);
+}
+
 static HRESULT WINAPI transform_ProcessMessage(IMFTransform *iface, MFT_MESSAGE_TYPE message, ULONG_PTR param)
 {
     struct video_decoder *decoder = impl_from_IMFTransform(iface);
@@ -863,6 +892,14 @@
     switch (message)
     {
     case MFT_MESSAGE_SET_D3D_MANAGER:
+        /* Riftway: a decoder that cannot use the device says so (E_NOTIMPL, as
+         * documented for MFTs without Direct3D support) and keeps decoding to
+         * memory, which the caller then uploads. */
+        if (param && !device_holds_frames((IUnknown *)param))
+        {
+            WARN("Device manager %p cannot hold NV12 frames, decoding to memory.\n", (void *)param);
+            return E_NOTIMPL;
+        }
         if (FAILED(hr = IMFVideoSampleAllocatorEx_SetDirectXManager(decoder->allocator, (IUnknown *)param)))
             return hr;
 
